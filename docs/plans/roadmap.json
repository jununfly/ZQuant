      "decisions": [
        {
          "q": "滴滴实现方式?",
          "answer": "T+1日收盘近似 B信号次日收盘涨幅<2%或跌破买入价(前日收盘)",
          "note": "日线无分钟线 实盘需人工盘口确认"
        },
        {
          "q": "S2 M头双顶方案?",
          "answer": "scipy.signal.find_peaks极值法 峰高相似度>=97% 跌破颈线确认",
          "note": "来自GitHub最佳实践"
        },
        {
          "q": "S1 量化定义?",
          "answer": "J>=j_overbought连续>=divergence_bars日(钝化) + 当日量比>1但涨幅<1%(放量滞涨)",
          "note": "j_overbought=100 divergence_bars=5"
        },
        {
          "q": "S3 量化定义?",
          "answer": "顶背离(divergence_period内价格新高但J未新高) + 均线拐头(MA5下穿MA20或MA20连续下降)",
          "note": "divergence_period=20"
        }
      ],
      "notes": "M3全部子任务完成"
    },
