      "decisions": [
        {
          "q": "B3 量化定义?",
          "answer": "前提:上升趋势(MA5>MA20) B3a单针下20:下影线>=实体50% B3b砖型底部:连续>=5日振幅<=1.5%量能<=前10日均量50%",
          "note": "needle_shadow_ratio=0.5 brick params"
        },
        {
          "q": "B2 量化定义?",
          "answer": "5日均线上穿20日均线(金叉) + 当日量>=前5日均量1.5倍 + 收盘站上20日线 + 次日确认仍在20日线上",
          "note": "volume_ratio=1.5 confirmation_days=1"
        },
        {
          "q": "scan 命令形态?",
          "answer": "zquant scan 全市场 zquant scan --days N 近N天 zquant scan code 单只详细",
          "note": ""
        },
        {
          "q": "选股方式?",
          "answer": "全市场自动扫描 遍历TDX所有.day文件 不维护股票池",
          "note": "不复用TDX .blk临时分类"
        },
        {
          "q": "B1 量化定义?",
          "answer": "KDJ J值<=-10连续>=2日 触发: J值拐头向上(当日J>前日J) 即超卖区企稳反转第一根",
          "note": "j_oversold=-10 min_consecutive_days=2"
        }
      ],
      "notes": "M2全部子任务完成"
    },
    "1-9": {
      "id": "1-9",
      "label": "M3: S系列卖点+滴滴风控",
